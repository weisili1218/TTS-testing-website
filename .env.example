# 複製成 .env 後修改。全部都是選填。

# ════════════════════════════════════════════════════════ 四包 TTS gateway
# 引擎清單本身寫在 engines.json（複製 engines.example.json 再改）。
# 四包通常跑在同一台 GPU 主機上，只有 port 不同，所以主機位址集中在這裡：
TTS_HOST=192.168.1.223

# 各 gateway 的 API_KEY（在它們的 compose.yaml 裡設的）。沒設就留空。
# TTS_API_KEY=

# 合成的逾時（gateway 端預設 REQUEST_TIMEOUT=600）
# TTS_TIMEOUT=600
# TTS_CONNECT_TIMEOUT=10
# TTS_MAX_RETRIES=2

# 能力探測（GET /v1/models）的逾時。刻意比合成短很多 ——
# 引擎關機時開頁面不該卡住。
# TTS_CAPS_TIMEOUT=6
# TTS_CAPS_CONNECT_TIMEOUT=3
# TTS_CAPS_TTL=60

# 也可以完全不用 engines.json，直接用環境變數：
# TTS_ENGINES=cosyvoice2=http://192.168.1.223:18001,voxcpm2=http://192.168.1.223:18004

# ═══════════════════════════════════════════ 客觀評分用的 Whisper ASR
# POST {ASR_BASE_URL}/speech-asr  multipart file=<wav>  ->  {"text": "..."}
# 沒設就沿用 F5_BASE_URL；兩個都空則停用 CER 評分。
ASR_BASE_URL=http://192.168.1.223:8000
# ASR_LANGUAGE=zh
# ASR_TIMEOUT=120

# ══════════════════════════════════════════ 舊的 F5-TTS（介面不一樣，選用）
# 留空 = 停用，不會出現在 UI 上。
F5_BASE_URL=http://192.168.1.223:8000
# F5 的 ref_audio 只吃它自己主機上的路徑，留空 = 用它內建的預設音色
# F5_REF_AUDIO=/data/voices/dami.wav
# F5_REF_TEXT=

# ══════════════════════════════════════════════════════════════ 平台
# HOST=127.0.0.1
# PORT=8080

# 設定後所有 /api 需帶 X-API-Key 標頭（本機自用可不設）
# API_KEY=

# 合成參數（所有引擎共用 —— 切法一致，速度才可比）
# MAX_CHARS_PER_SEGMENT=60
# SEGMENT_GAP_SECONDS=0.18
# MAX_TEXT_CHARS=2000
# MIN_PROMPT_SECONDS=2
# MAX_PROMPT_SECONDS=30

# ══════════════════════════════════════════════════════════ 評測行為
# 預設模式：duel（抽兩個對決）/ ranking（全部排名）/ open（不盲測）
# DEFAULT_TRIAL_MODE=duel
# DEFAULT_REPEATS=1
# MAX_REPEATS=10

# 每次評測隨機決定誰先跑，避免「先跑的比較冷」造成系統性偏差
# RANDOMIZE_RUN_ORDER=true

# 上傳／修改音色後自動推送到各引擎（音色可比的前提）
# AUTO_PUSH_VOICE=true

# Elo：K 越大越快反應近期表現，但也越抖
# ELO_K=24
# ELO_START=1500
# ELO_BOOTSTRAP=200

# 保留幾筆評測紀錄（含音檔）
# TRIALS_LIMIT=500
